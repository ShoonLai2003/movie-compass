<h2>投稿詳細</h2>

<p>タイトル：<%= @post.title %></p>
<p>投稿者：<%= @post.user.name %></p>
<p>評価：<%= @post.rating %></p>
<p>本文：<%= @post.body %></p>
<p>コメント数：<%= @post.comments.count %></p>

<%= link_to "投稿を削除",admin_post_path(@post),
    data: {turbo_method: :delete,turbo_confirm: "本当にこの投稿を削除しますか？"} %>

<%= link_to "投稿一覧へ戻る", admin_posts_path %>