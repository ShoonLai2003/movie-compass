<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="rounded-3 p-4 mb-4"
           style="background-color: #172233;">

        <p class="fw-bold mb-1"
           style="color: #f4be55;">
          MOVIE COMPASS
        </p>

        <h1 class="h3 fw-bold text-white mb-1">
          管理者トップ
        </h1>

        <p class="text-white-50 mb-0">
          ADMIN DASHBOARD
        </p>
      </div>

      <div class="row g-4">

        <div class="col-12 col-md-4">
          <div class="card h-100 shadow-sm border-0 rounded-3">
            <div class="card-body p-4 d-flex flex-column text-center">

              <h2 class="h5 fw-bold mb-3">
                ユーザー管理
              </h2>

              <hr class="mb-4"
                  style="border: 2px solid #f4be55; opacity: 1;">

              <div class="mt-auto d-grid">
                <%= link_to "ユーザー一覧へ",admin_users_path,class: "btn text-white fw-semibold py-2",style: "background-color: #172233;" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="card h-100 shadow-sm border-0 rounded-3">
            <div class="card-body p-4 d-flex flex-column text-center">

              <h2 class="h5 fw-bold mb-3">
                投稿管理
              </h2>

              <hr class="mb-4"
                  style="border: 2px solid #f4be55; opacity: 1;">

              <div class="mt-auto d-grid">
                <%= link_to "投稿一覧へ",admin_posts_path,class: "btn text-white fw-semibold py-2",style: "background-color: #172233;" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="card h-100 shadow-sm border-0 rounded-3">
            <div class="card-body p-4 d-flex flex-column text-center">

              <h2 class="h5 fw-bold mb-3">
                コメント管理
              </h2>

              <hr class="mb-4"
                  style="border: 2px solid #f4be55; opacity: 1;">

              <div class="mt-auto d-grid">
                <%= link_to "コメント一覧へ",admin_comments_path,class: "btn text-white fw-semibold py-2",style: "background-color: #172233;" %>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>