<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="mb-4">ユーザー詳細</h2>

          <p>
            <strong>名前：</strong>
            <%= @user.name %>
          </p>

          <p>
            <strong>メールアドレス：</strong>
            <%= @user.email %>
          </p>

          <p>
            <strong>会員ステータス：</strong>

            <% if @user.is_active %>
              <span class="badge text-bg-success">有効</span>
            <% else %>
              <span class="badge text-bg-secondary">退会済み</span>
            <% end %>
          </p>

          <div class="d-flex flex-wrap gap-2 mt-4">
            <% if @user.is_active %>
              <%= link_to "退会",
                  admin_user_path(@user),
                  data: {
                    turbo_method: :patch,
                    turbo_confirm: "本当に退会処理を行いますか？"
                  },
                  class: "btn btn-outline-danger" %>
            <% end %>

            <%= link_to "ユーザー一覧へ戻る",admin_users_path,class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>