<div class="movie-post-page">
  <div class="container py-5">

    <div class="movie-post-heading text-center">
      <p class="movie-post-label">EDIT YOUR MOVIE REVIEW</p>
      <h1>投稿編集</h1>
      <p>映画の感想を編集しましょう。</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <div class="card movie-post-card">
          <div class="card-body p-4 p-md-5">

            <% if @post.errors.any? %>
              <div class="alert alert-danger">
                <h2 class="h6">
                  <%= @post.errors.count %>件のエラーがあります
                </h2>

                <ul class="mb-0">
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%= form_with model: @post do |f| %>

              <div class="mb-4">
                <%= f.label :title, "タイトル", class: "form-label" %>
                <%= f.text_field :title,class: "form-control",placeholder: "映画のタイトルを入力" %>
              </div>

              <div class="mb-4">
                <%= f.label :body, "レビュー", class: "form-label" %>
                <%= f.text_area :body,class: "form-control",rows: 5,placeholder: "映画の感想を書いてください" %>
              </div>

              <div class="mb-4">
                <label class="form-label">評価</label>
                <div id="edit-post-rating"></div>
                <p class="text-muted small mt-2">
                  ※投稿後は評価を変更できません。
                </p>
              </div>

              <script>
                document.addEventListener("turbo:load", function() {
                  const elem = document.querySelector("#edit-post-rating");

                  if (elem && elem.children.length === 0) {
                    raty(elem, {score: <%= @post.rating.to_i %>,readOnly: true,
                      starOff: "<%= asset_path('star-off.png') %>",
                      starOn: "<%= asset_path('star-on.png') %>",
                      starHalf: "<%= asset_path('star-half.png') %>"
                    });
                  }
                });
              </script>

              <div class="d-grid">
                <%= f.submit "更新する",class: "btn movie-post-submit" %>
              </div>

            <% end %>

            <div class="text-center mt-4">
              <%= link_to "← 投稿詳細へ戻る",post_path(@post),class: "movie-post-back" %>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</div>