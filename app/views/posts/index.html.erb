<div class="posts-page">
  <div class="container py-5">
    <div class="posts-page-header">
      <div>
        <p class="posts-page-label">EXPLORE MOVIE REVIEWS</p>
        <h1>みんなの映画レビュー</h1>
        <p class="posts-page-description">
          レビューや評価から、次に観たい映画を見つけよう。
        </p>
      </div>

      <%= link_to "＋ 新規投稿",new_post_path,class: "btn posts-new-button" %>
    </div>

    <div class="posts-sort">
      <span class="posts-sort-label">並び替え</span>

      <%= link_to "新しい順",posts_path,
          class: "posts-sort-link #{params[:sort] == 'rating' ? '' : 'active'}" %>

      <%= link_to "評価の高い順",posts_path(sort: "rating"),
          class: "posts-sort-link #{params[:sort] == 'rating' ? 'active' : ''}" %>
    </div>

    <div class="row g-4">
      <% @posts.each do |post| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card posts-card h-100">
            <div class="card-body d-flex flex-column">

              <div class="posts-card-tags">
                <% post.tags.each do |tag| %>
                  <%= link_to tag.name,search_path(range: "Tag", word: tag.name),class: "posts-tag" %>
                <% end %>
              </div>

              <h2 class="posts-card-title">
                <%= post.title %>
              </h2>

              <p class="posts-card-author">
                投稿者：<%= post.user.name %>
              </p>

              <div class="posts-card-rating">
                <span class="posts-rating-label">映画評価</span>
                <div id="post-rating-<%= post.id %>"></div>
              </div>

              <script>
                document.addEventListener("turbo:load", function() {
                  const elem = document.querySelector("#post-rating-<%= post.id %>");

                  if (elem && elem.children.length === 0) {
                    raty(elem, {score: <%= post.rating %>,readOnly: true,
                      starOff: "<%= asset_path('star-off.png') %>",
                      starOn: "<%= asset_path('star-on.png') %>",
                      starHalf: "<%= asset_path('star-half.png') %>"
                    });
                  }
                });
              </script>

              <div class="posts-card-footer mt-auto">
                <div>
                  <p class="posts-card-comments">
                    コメント <%= post.comments.count %>件
                  </p>

                  <%= render "favorites/btn", post: post %>
                </div>

                <%= link_to "レビューを見る →",post_path(post),class: "btn posts-detail-button" %>
              </div>

            </div>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</div>