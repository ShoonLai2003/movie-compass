<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">投稿一覧</h1>

    <%= link_to "新規投稿", new_post_path, class: "btn btn-primary" %>
  </div>

  <div class="mb-4">
    <%= link_to "新しい順", posts_path %>
    <span class="mx-2">|</span>
    <%= link_to "評価の高い順", posts_path(sort: "rating") %>
  </div>
  
  <div class="row g-4">
    <% @posts.each do |post| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h2 class="h5 card-title">
              <%= post.title %>
            </h2>

            <p class="card-text mb-2">
              投稿者：<%= post.user.name %>
            </p>
            <div class="mb-2">
              <% post.tags.each do |tag| %>
                <%= link_to tag.name,
                    search_path(range: "Tag", word: tag.name),
                    class: "badge text-bg-secondary text-decoration-none me-1" %>
              <% end %>
            </div>

            <div class="card-text mb-2">
              <span>評価：</span>
              <div id="post-rating-<%= post.id %>"></div>
            </div>

            <script>
              document.addEventListener("turbo:load", function() {
                const elem = document.querySelector("#post-rating-<%= post.id %>");

                if (elem && elem.children.length === 0) {
                  raty(elem, {
                    score: <%= post.rating %>,
                    readOnly: true,
                    starOff: "<%= asset_path('star-off.png') %>",
                    starOn: "<%= asset_path('star-on.png') %>",
                    starHalf: "<%= asset_path('star-half.png') %>"
                  });
                }
              });
            </script>

            <p class="card-text mb-3">
              コメント数：<%= post.comments.count %>
            </p>

            <%= link_to "詳細を見る",
                post_path(post),
                class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>