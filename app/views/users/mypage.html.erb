<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="rounded-3 p-4 mb-4"style="background-color: #172233;">
        <p class="mb-1 fw-bold"style="color: #f4be55;">
          MOVIE COMPASS
        </p>
        <h1 class="text-white fw-bold mb-1">
          マイページ
        </h1>
        <p class="text-white-50 mb-0">MY PAGE</p>
      </div>

      <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">

          <h2 class="h4 fw-bold mb-3"style="color: #172233;">
            ユーザー情報
          </h2>

          <hr style="border: 2px solid #f4be55; opacity: 1;">

          <p class="mb-2">
            <strong>名前：</strong><%= @user.name %>
          </p>

          <p class="mb-4">
            <strong>メールアドレス：</strong><%= @user.email %>
          </p>

          <div class="d-flex flex-wrap gap-2">
            <%= link_to "ユーザー情報を編集",edit_user_registration_path,class: "btn text-white",style: "background-color: #172233;" %>

            <%= link_to "退会する",user_registration_path,data: {turbo_method: :delete,turbo_confirm: "本当に退会しますか？"},class: "btn btn-outline-danger" %>
          </div>
        </div>
      </div>

      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

          <h2 class="h4 fw-bold mb-3"style="color: #172233;">
            自分の投稿一覧
          </h2>

          <hr style="border: 2px solid #f4be55; opacity: 1;">

          <% if @posts.any? %>
            <div class="row g-3">

              <% @posts.each do |post| %>
                <div class="col-12 col-md-6">

                  <div class="card h-100 rounded-3">
                    <div class="card-body p-4 d-flex flex-column">

                      <h3 class="h5 fw-bold mb-3"
                          style="color: #172233;">
                        <%= post.title %>
                      </h3>

                      <div class="mb-3">
                        <div id="mypage-post-rating-<%= post.id %>"></div>

                        <p class="text-muted small mb-0">
                          評価：<%= post.rating %> / 5
                        </p>
                      </div>

                      <script>
                        document.addEventListener("turbo:load", function() {
                          const elem = document.querySelector("#mypage-post-rating-<%= post.id %>");

                          if (elem && elem.children.length === 0) {
                            raty(elem, {score: <%= post.rating %>,readOnly: true,
                              starOff: "<%= asset_path('star-off.png') %>",
                              starOn: "<%= asset_path('star-on.png') %>",
                              starHalf: "<%= asset_path('star-half.png') %>"
                            });
                          }
                        });
                      </script>

                      <%= link_to "詳細を見る",post_path(post),class: "btn text-white mt-auto",style: "background-color: #172233;" %>
                    </div>
                  </div>

                </div>
              <% end %>

            </div>
          <% else %>
            <p class="text-muted mb-0">
              まだ投稿がありません。
            </p>
          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>