<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

          <h2 class="h3 fw-bold mb-4" style="color: #172233;">
            <%= @user.name %>さんの投稿
          </h2>

          <% if @posts.any? %>
            <div class="row g-3">
              <% @posts.each do |post| %>
                <div class="col-12 col-md-6">
                  <div class="card h-100 shadow-sm rounded-3">
                    <div class="card-body p-4 d-flex flex-column">

                      <h3 class="h5 fw-bold mb-3" style="color: #172233;">
                        <%= post.title %>
                      </h3>

                      <div class="mb-3">
                        <span class="fw-semibold">評価：</span>
                        <div id="user-post-rating-<%= post.id %>"></div>
                      </div>

                      <script>
                        document.addEventListener("turbo:load", function() {
                          const elem = document.querySelector("#user-post-rating-<%= post.id %>");

                          if (elem && elem.children.length === 0) {
                            raty(elem, {score: <%= post.rating %>,readOnly: true,
                              starOff: "<%= asset_path('star-off.png') %>",
                              starOn: "<%= asset_path('star-on.png') %>",
                              starHalf: "<%= asset_path('star-half.png') %>"
                            });
                          }
                        });
                      </script>

                      <p class="text-muted mb-3">
                        コメント数：<%= post.comments.count %>
                      </p>

                      <%= link_to "詳細を見る",post_path(post),class: "btn mt-auto text-white",style: "background-color: #172233;" %>

                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">
              まだ投稿はありません。
            </p>
          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>