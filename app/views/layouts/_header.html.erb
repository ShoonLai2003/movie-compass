<header>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <%= link_to "Movie Compass", root_path, class: "navbar-brand fw-bold" %>

      <button class="navbar-toggler" type="button"
              data-bs-toggle="collapse"
              data-bs-target="#navbarNav"
              aria-controls="navbarNav"
              aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <div class="navbar-nav me-auto">
          <% if admin_signed_in? %>
            <%= link_to "管理者トップ", admin_root_path, class: "nav-link" %>
            <%= link_to "ユーザー管理", admin_users_path, class: "nav-link" %>
            <%= link_to "投稿管理", admin_posts_path, class: "nav-link" %>
            <%= link_to "コメント管理", admin_comments_path, class: "nav-link" %>
            <%= link_to "ログアウト",destroy_admin_session_path,
                data: { turbo_method: :delete },class: "nav-link" %>
          <% else %>
            <%= link_to "TOP", root_path, class: "nav-link" %>
            <%= link_to "ABOUT", about_path, class: "nav-link" %>

            <% if user_signed_in? %>
              <%= link_to "投稿一覧", posts_path, class: "nav-link" %>
              <%= link_to "新規投稿", new_post_path, class: "nav-link" %>
              <%= link_to "マイページ", mypage_path, class: "nav-link" %>
              <%= link_to "ログアウト",destroy_user_session_path,
                  data: { turbo_method: :delete },class: "nav-link" %>
            <% else %>
              <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
              <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
            <% end %>
          <% end %>
        </div>

        <% if user_signed_in? && !admin_signed_in? %>
          <div class="d-flex mt-3 mt-lg-0">
            <%= form_with url: search_path,method: :get,local: true,class: "d-flex gap-2" do |f| %>

              <%= f.select :range,
                  options_for_select([["ユーザー", "User"], ["投稿", "Post"]]),{},class: "form-select" %>

              <%= f.text_field :word,
                  placeholder: "キーワードを入力",class: "form-control" %>

              <%= f.submit "検索",
                  class: "btn btn-outline-light" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </nav>
</header>