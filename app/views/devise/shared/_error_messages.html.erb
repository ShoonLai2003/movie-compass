<% if resource.errors.any? %>
  <div class="alert alert-danger" role="alert" data-turbo-temporary>
    <h2 class="h6 mb-3">
      入力内容にエラーがあります。
    </h2>

    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>