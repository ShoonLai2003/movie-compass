<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">

      <div class="rounded-3 p-4 mb-4"
           style="background-color: #172233;">

        <p class="fw-bold mb-1"
           style="color: #f4be55;">
          MOVIE COMPASS
        </p>

        <h1 class="h3 fw-bold text-white mb-1">
          新規登録
        </h1>

        <p class="text-white-50 mb-0">
          CREATE ACCOUNT
        </p>
      </div>

      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
          <%= form_for(resource,as: resource_name,url: registration_path(resource_name)) do |f| %>

            <%= render "devise/shared/error_messages",
                resource: resource %>

            <div class="mb-3">
              <%= f.label :name,"名前",class: "form-label fw-semibold" %>

              <%= f.text_field :name,autofocus: true,autocomplete: "name",class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email,"メールアドレス",class: "form-label fw-semibold" %>

              <%= f.email_field :email,autocomplete: "email",class: "form-control" %>
            </div>

            <hr class="my-4"
                style="border: 2px solid #f4be55; opacity: 1;">

            <div class="mb-3">
              <%= f.label :password,"パスワード",class: "form-label fw-semibold" %>

              <% if @minimum_password_length %>
                <div class="form-text mb-2">
                  <%= @minimum_password_length %>文字以上
                </div>
              <% end %>

              <%= f.password_field :password,autocomplete: "new-password",class: "form-control" %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation,"パスワード確認",class: "form-label fw-semibold" %>

              <%= f.password_field :password_confirmation,autocomplete: "new-password",class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= f.submit "新規登録",class: "btn text-white fw-semibold py-2",style: "background-color: #172233;" %>
            </div>

          <% end %>

          <div class="mt-4 text-center">
            <%= render "devise/shared/links" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>